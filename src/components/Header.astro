---
// src/components/Header.astro

const navLinks = [
  { href: "https://gymnasium201-kyiv.github.io", label: "Новини" },
  { href: "https://gymnasium201-kyiv.github.io/informaciya_pro_zaklad/", label: "Інформація про заклад" },
  { href: "https://gymnasium201-kyiv.github.io/istoriya_shkoli/", label: "Історія гімназії" },
  { href: "https://gymnasium201-kyiv.github.io/vidkritistj_ta_prozoristj_zakladu_osviti/", label: "Прозорість та інформаційна відкритість закладу" },
  { href: "https://gymnasium201-kyiv.github.io/zaklad_chastina_yevropejsjkogo_osvitnjogo_prostoru/", label: "Заклад - частина європейського освітнього простору" },
  { href: "https://gymnasium201-kyiv.github.io/osvitnij_proces/", label: "Освітній процес" },
];

const socialLinks = [
  { href: "https://www.facebook.com/szsh201", icon: "fa-brands fa-facebook-f", label: "Facebook" },
  { href: "https://t.me/s/szch201Kyiv", icon: "fa-brands fa-telegram", label: "Telegram" },
];
---

<header class="sticky top-0 z-50 bg-slate-900/90 backdrop-blur-md border-b border-white/10 shadow-md">
    <nav class="max-w-7xl mx-auto px-4 sm:px-6 flex items-center justify-between h-auto min-h-[3.5rem] py-2 text-sm font-medium">
        
        <!-- Desktop Navigation Menu Links -->
        <div class="hidden xl:flex items-center space-x-3 2xl:space-x-5 py-1">
            {navLinks.map((link, index) => (
                <a 
                    href={link.href} 
                    class={`transition-colors px-2 py-1 rounded-md text-xs 2xl:text-sm whitespace-nowrap ${index === 0 ? 'text-white hover:text-amber-300 font-semibold' : 'text-slate-200 hover:text-amber-300'}`}
                >
                    {link.label}
                </a>
            ))}
        </div>

        <!-- Mobile Menu Button -->
        <div class="flex xl:hidden items-center justify-between w-full">
            <span class="text-xs uppercase tracking-wider text-slate-300 font-oswald flex items-center gap-2">
                <i class="fa-solid fa-graduation-cap text-amber-400"></i> Гімназія №201
            </span>
            <button id="mobile-menu-btn" aria-label="Відкрити меню" class="p-2 rounded-lg bg-white/10 hover:bg-white/20 text-white focus:outline-none transition-colors flex items-center gap-2 text-sm font-semibold">
                <span>Меню</span>
                <i id="hamburger-icon" class="fa-solid fa-bars text-lg"></i>
            </button>
        </div>

        <!-- Social Icons (Desktop) -->
        <div class="social-icons hidden xl:flex items-center gap-2 ml-4 flex-shrink-0">
            {socialLinks.map((social) => (
                <a href={social.href} target="_blank" rel="noopener noreferrer" aria-label={social.label} class="w-8 h-8 rounded-full bg-white/10 hover:bg-white/30 flex items-center justify-center transition-all text-xs text-white">
                    <i class={social.icon}></i>
                </a>
            ))}
        </div>
    </nav>

    <!-- Mobile Dropdown Navigation Drawer -->
    <div id="mobile-menu" class="hidden xl:hidden bg-slate-900/95 border-t border-white/10 px-4 py-3 space-y-2 backdrop-blur-lg">
        {navLinks.map((link) => (
            <a href={link.href} class="mobile-nav-link block text-slate-100 hover:bg-white/10 hover:text-amber-300 px-3 py-2 rounded-lg text-sm font-medium transition-colors">
                {link.label}
            </a>
        ))}
        
        <div class="pt-3 mt-2 border-t border-white/10 flex items-center justify-around">
            {socialLinks.map((social) => (
                <a href={social.href} target="_blank" class="text-slate-300 hover:text-white text-lg" aria-label={social.label}>
                    <i class={social.icon}></i>
                </a>
            ))}
        </div>
    </div>
</header>

<script>
    function setupMobileMenu() {
        const menuBtn = document.getElementById('mobile-menu-btn');
        const menu = document.getElementById('mobile-menu');
        const icon = document.getElementById('hamburger-icon');
        const navLinks = document.querySelectorAll('.mobile-nav-link');

        if (!menuBtn || !menu || !icon) return;

        function toggleMobileMenu() {
            const isHidden = menu.classList.contains('hidden');
            if (isHidden) {
                menu.classList.remove('hidden');
                icon.classList.remove('fa-bars');
                icon.classList.add('fa-xmark');
            } else {
                menu.classList.add('hidden');
                icon.classList.remove('fa-xmark');
                icon.classList.add('fa-bars');
            }
        }

        menuBtn.addEventListener('click', toggleMobileMenu);

        navLinks.forEach(link => {
            link.addEventListener('click', () => {
                menu.classList.add('hidden');
                icon.classList.remove('fa-xmark');
                icon.classList.add('fa-bars');
            });
        });
    }

    document.addEventListener('astro:page-load', setupMobileMenu);
    document.addEventListener('DOMContentLoaded', setupMobileMenu);
</script>
