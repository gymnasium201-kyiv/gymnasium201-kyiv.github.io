---
// SchoolBlogPages.astro
---

<nav aria-label="Пагінація сторінок" class="flex justify-center items-center space-x-2 my-10" id="pages_area">
  <!-- Заглушка для початкового стану / скелетон під час завантаження -->
  <div class="inline-flex items-center space-x-2 animate-pulse">
    <div class="w-10 h-10 rounded-full bg-slate-200"></div>
    <div class="w-10 h-10 rounded-full bg-slate-300"></div>
    <div class="w-10 h-10 rounded-full bg-slate-200"></div>
  </div>
</nav>

<script>
  async function renderPagination() {
    const urlParams = new URLSearchParams(window.location.search);
    const page_id = parseInt(urlParams.get("page") || "1", 10);

    const pages_area = document.getElementById("pages_area");
    if (!pages_area) return;

    try {
      const response = await fetch('https://raw.githubusercontent.com/gymnasium201-kyiv/news-storage/refs/heads/main/storage_info.json');
      const json = await response.json();
      
      const postsPerPage = 9;
      const totalPosts = json['posts'] ? json['posts'].length : 0;
      const all_pages = Math.ceil(totalPosts / postsPerPage) || 1;

      pages_area.innerHTML = '';

      // Базові стилі для кнопок
      const baseBtnClass = "w-10 h-10 rounded-full flex items-center justify-center font-oswald text-sm font-semibold transition-all duration-200 shadow-sm";
      const inactiveBtnClass = `${baseBtnClass} bg-white text-slate-700 hover:bg-slate-100 hover:text-brand-600 hover:shadow-md border border-slate-200/80`;
      const activeBtnClass = `${baseBtnClass} btn-gradient-shadow text-white scale-105 font-bold`;
      const navBtnClass = `${baseBtnClass} bg-white text-slate-600 hover:bg-brand-50 hover:text-brand-600 hover:shadow-md border border-slate-200/80 active:scale-95`;
      const ellipsisClass = "px-2 text-slate-400 font-bold select-none";

      // Кнопка "Назад"
      if (page_id > 1) {
        pages_area.innerHTML += `
          <a href="?page=${page_id - 1}" class="${navBtnClass}" aria-label="Попередня сторінка">
            <i class="fa-solid fa-chevron-left text-xs"></i>
          </a>`;
      }

      // Перша сторінка
      if (page_id > 2) {
        pages_area.innerHTML += `<a href="?page=1" class="${inactiveBtnClass}">1</a>`;
      }

      // Еліпси на початку
      if (page_id > 3) {
        pages_area.innerHTML += `<span class="${ellipsisClass}">•••</span>`;
      }

      // Генерація діапазону сторінок навколо поточної
      let start_page = Math.max(1, page_id - 1);
      let end_page = Math.min(all_pages, page_id + 1);

      if (page_id <= 2) {
        end_page = Math.min(all_pages, 3);
      }

      if (page_id >= all_pages - 1) {
        start_page = Math.max(1, all_pages - 2);
      }

      for (let i = start_page; i <= end_page; i++) {
        const isActive = i === page_id;
        const buttonClass = isActive ? activeBtnClass : inactiveBtnClass;
        pages_area.innerHTML += `<a href="?page=${i}" class="${buttonClass}" ${isActive ? 'aria-current="page"' : ''}>${i}</a>`;
      }

      // Еліпси в кінці
      if (page_id < all_pages - 2) {
        pages_area.innerHTML += `<span class="${ellipsisClass}">•••</span>`;
      }

      // Остання сторінка
      if (page_id < all_pages - 1) {
        pages_area.innerHTML += `<a href="?page=${all_pages}" class="${inactiveBtnClass}">${all_pages}</a>`;
      }

      // Кнопка "Вперед"
      if (page_id < all_pages) {
        pages_area.innerHTML += `
          <a href="?page=${page_id + 1}" class="${navBtnClass}" aria-label="Наступна сторінка">
            <i class="fa-solid fa-chevron-right text-xs"></i>
          </a>`;
      }
    } catch (error) {
      console.error("Помилка завантаження пагінації:", error);
    }
  }

  // Запуск логіки при завантаженні
  renderPagination();
</script>

<style is:global>
  /* Стиль фонового градієнта та тіні для активної сторінки (у стилі дизайну 201.html) */
  .btn-gradient-shadow {
    background-image: linear-gradient(135deg, #6366f1 0%, #4b6496 100%);
    box-shadow: 0 4px 14px rgba(75, 100, 150, 0.35);
  }
  .btn-gradient-shadow:hover {
    box-shadow: 0 6px 20px rgba(75, 100, 150, 0.45);
  }
</style>
