---
import schoollogo from "../assets/logo.jpg";
---

<div class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-10 font-inter">
    <!-- HERO HEADER CARD -->
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-[#394e77] via-[#4b6496] to-[#2c3e50] text-white p-8 sm:p-12 shadow-xl mb-10 border border-indigo-900/20">
        <!-- Background Decorative Elements -->
        <div class="absolute -right-10 -bottom-10 opacity-10 text-white pointer-events-none">
            <i class="fa-solid fa-graduation-cap text-[18rem]"></i>
        </div>

        <div class="relative z-10 max-w-3xl">
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/10 backdrop-blur-md text-amber-300 text-xs sm:text-sm font-semibold uppercase tracking-wider mb-4 border border-white/10">
                <i class="fa-solid fa-calendar-days"></i>
                <span>Навчальний графік</span>
            </div>
            <h1 class="font-oswald text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight leading-tight mb-4 drop-shadow-sm">
                Структура 2026–2027 навчального року
            </h1>
            <p class="text-slate-200 text-sm sm:text-base font-light leading-relaxed">
                Розклад семестрів, канікул та ключових подій навчального процесу в Гімназії №201 м. Києва.
            </p>
        </div>
    </div>

    <!-- MAIN CONTENT GRID -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        
        <!-- SEMESTERS SECTION (Left Column - 5 cols) -->
        <div class="lg:col-span-5 flex flex-col gap-6">
            <div class="page-title-container mb-2">
                <h2 class="font-oswald text-2xl sm:text-3xl font-bold text-slate-800 flex items-center gap-3">
                    <i class="fa-solid fa-bookmark text-brand-500"></i>
                    Навчальні семестри
                </h2>
            </div>

            <!-- First Semester Card -->
            <div class="bg-white rounded-2xl p-6 shadow-md border border-slate-200/80 hover:shadow-lg transition-shadow relative overflow-hidden group">
                <div class="absolute top-0 left-0 w-2 h-full bg-gradient-to-b from-brand-500 to-indigo-600"></div>
                <div class="flex items-start justify-between mb-3">
                    <span class="text-xs font-bold font-oswald uppercase tracking-wider text-brand-600 bg-brand-50 px-3 py-1 rounded-full">
                        I Семестр
                    </span>
                    <i class="fa-regular fa-calendar-check text-slate-400 text-xl group-hover:text-brand-500 transition-colors"></i>
                </div>
                <h3 class="font-oswald text-xl font-bold text-slate-900 mb-2">
                    Перший семестр
                </h3>
                <p class="text-slate-600 text-base font-medium flex items-center gap-2">
                    <i class="fa-solid fa-clock text-amber-500 text-sm"></i>
                    <span>01 вересня — 23 грудня 2026 року</span>
                </p>
            </div>

            <!-- Second Semester Card -->
            <div class="bg-white rounded-2xl p-6 shadow-md border border-slate-200/80 hover:shadow-lg transition-shadow relative overflow-hidden group">
                <div class="absolute top-0 left-0 w-2 h-full bg-gradient-to-b from-indigo-600 to-brand-700"></div>
                <div class="flex items-start justify-between mb-3">
                    <span class="text-xs font-bold font-oswald uppercase tracking-wider text-indigo-600 bg-indigo-50 px-3 py-1 rounded-full">
                        II Семестр
                    </span>
                    <i class="fa-regular fa-calendar-check text-slate-400 text-xl group-hover:text-indigo-600 transition-colors"></i>
                </div>
                <h3 class="font-oswald text-xl font-bold text-slate-900 mb-2">
                    Другий семестр
                </h3>
                <p class="text-slate-600 text-base font-medium flex items-center gap-2">
                    <i class="fa-solid fa-clock text-amber-500 text-sm"></i>
                    <span>11 січня — 28 травня 2027 року</span>
                </p>
            </div>
        </div>

        <!-- VACATIONS & EVENTS SECTION (Right Column - 7 cols) -->
        <div class="lg:col-span-7 flex flex-col gap-6">
            <div class="page-title-container mb-2">
                <h2 class="font-oswald text-2xl sm:text-3xl font-bold text-slate-800 flex items-center gap-3">
                    <i class="fa-solid fa-umbrella-beach text-amber-500"></i>
                    Канікули та урочисті події
                </h2>
            </div>

            <div class="bg-white rounded-2xl p-6 sm:p-8 shadow-md border border-slate-200/80 space-y-4">
                
                <!-- Autumn Vacations -->
                <div class="flex items-center justify-between p-4 rounded-xl bg-slate-50 border border-slate-100 hover:bg-amber-50/50 transition-colors">
                    <div class="flex items-center gap-3.5">
                        <div class="w-10 h-10 rounded-full bg-amber-100 text-amber-700 flex items-center justify-center flex-shrink-0 font-bold text-lg">
                            <i class="fa-solid fa-leaf"></i>
                        </div>
                        <div>
                            <h4 class="font-oswald text-base sm:text-lg font-bold text-slate-800">Осінні канікули</h4>
                            <p class="text-xs sm:text-sm text-slate-500">Відпочинок восени</p>
                        </div>
                    </div>
                    <span class="font-oswald text-sm sm:text-base font-semibold text-amber-700 bg-amber-100/80 px-3 py-1.5 rounded-lg whitespace-nowrap">
                        26.10.2026 — 01.11.2026
                    </span>
                </div>

                <!-- Winter Vacations -->
                <div class="flex items-center justify-between p-4 rounded-xl bg-slate-50 border border-slate-100 hover:bg-blue-50/50 transition-colors">
                    <div class="flex items-center gap-3.5">
                        <div class="w-10 h-10 rounded-full bg-blue-100 text-blue-700 flex items-center justify-center flex-shrink-0 font-bold text-lg">
                            <i class="fa-solid fa-snowflake"></i>
                        </div>
                        <div>
                            <h4 class="font-oswald text-base sm:text-lg font-bold text-slate-800">Зимові канікули</h4>
                            <p class="text-xs sm:text-sm text-slate-500">Новорічні та різдвяні свята</p>
                        </div>
                    </div>
                    <span class="font-oswald text-sm sm:text-base font-semibold text-blue-700 bg-blue-100/80 px-3 py-1.5 rounded-lg whitespace-nowrap">
                        24.12.2026 — 10.01.2027
                    </span>
                </div>

                <!-- 1st Grade Additional Vacations -->
                <div class="flex items-center justify-between p-4 rounded-xl bg-slate-50 border border-slate-100 hover:bg-purple-50/50 transition-colors">
                    <div class="flex items-center gap-3.5">
                        <div class="w-10 h-10 rounded-full bg-purple-100 text-purple-700 flex items-center justify-center flex-shrink-0 font-bold text-lg">
                            <i class="fa-solid fa-child"></i>
                        </div>
                        <div>
                            <h4 class="font-oswald text-base sm:text-lg font-bold text-slate-800">Додаткові канікули</h4>
                            <p class="text-xs sm:text-sm text-slate-500">Спеціально для здобувачів освіти 1-х класів</p>
                        </div>
                    </div>
                    <span class="font-oswald text-sm sm:text-base font-semibold text-purple-700 bg-purple-100/80 px-3 py-1.5 rounded-lg whitespace-nowrap">
                        15.02.2027 — 21.02.2027
                    </span>
                </div>

                <!-- Spring Vacations -->
                <div class="flex items-center justify-between p-4 rounded-xl bg-slate-50 border border-slate-100 hover:bg-emerald-50/50 transition-colors">
                    <div class="flex items-center gap-3.5">
                        <div class="w-10 h-10 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center flex-shrink-0 font-bold text-lg">
                            <i class="fa-solid fa-seedling"></i>
                        </div>
                        <div>
                            <h4 class="font-oswald text-base sm:text-lg font-bold text-slate-800">Весняні канікули</h4>
                            <p class="text-xs sm:text-sm text-slate-500">Весняний перепочинок</p>
                        </div>
                    </div>
                    <span class="font-oswald text-sm sm:text-base font-semibold text-emerald-700 bg-emerald-100/80 px-3 py-1.5 rounded-lg whitespace-nowrap">
                        22.03.2027 — 28.03.2027
                    </span>
                </div>

                <!-- Last Bell Celebration -->
                <div class="flex items-center justify-between p-4 rounded-xl bg-gradient-to-r from-amber-500/10 to-amber-100/30 border border-amber-200 hover:shadow-sm transition-all">
                    <div class="flex items-center gap-3.5">
                        <div class="w-10 h-10 rounded-full bg-amber-500 text-white flex items-center justify-center flex-shrink-0 font-bold text-lg shadow-sm">
                            <i class="fa-solid fa-bell"></i>
                        </div>
                        <div>
                            <h4 class="font-oswald text-base sm:text-lg font-bold text-slate-900">Свято Останнього дзвоника</h4>
                            <p class="text-xs sm:text-sm text-slate-600">Завершення навчального року</p>
                        </div>
                    </div>
                    <span class="font-oswald text-sm sm:text-base font-bold text-white bg-amber-500 px-3.5 py-1.5 rounded-lg shadow-sm whitespace-nowrap">
                        28.05.2027
                    </span>
                </div>

            </div>
        </div>

    </div>
</div>

<style>
    /* Підключення шрифтів та глобальних класів за потреби */
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Oswald:wght@500;600;700&display=swap');

    body {
        font-family: 'Inter', sans-serif;
        background-color: #f8fafc;
    }
</style>
