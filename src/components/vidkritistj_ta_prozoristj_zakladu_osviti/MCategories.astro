---
// Отримання поточного URL для активного стану кнопок
const currentPath = Astro.url.pathname;

const menuItems = [
  {
    title: 'Статут',
    href: '/vidkritistj_ta_prozoristj_zakladu_osviti/statut',
    icon: 'fa-solid fa-file-contract',
    external: false
  },
  {
    title: 'Ліцензія',
    href: '/vidkritistj_ta_prozoristj_zakladu_osviti/licenziya',
    icon: 'fa-solid fa-certificate',
    external: false
  },
  {
    title: 'Структура та органи управління закладу освіти',
    href: '/vidkritistj_ta_prozoristj_zakladu_osviti/struktura_ta_organi_upravlinnya_zakladu_osviti',
    icon: 'fa-solid fa-sitemap',
    external: false
  },
  {
    title: 'Кадровий склад згідно з ліцензійними умовами',
    href: '/vidkritistj_ta_prozoristj_zakladu_osviti/kadrovij_sklad_zgidno_z_licenzijnimi_umovami',
    icon: 'fa-solid fa-users',
    external: false
  },
  {
    title: 'Освітні програми',
    href: '/vidkritistj_ta_prozoristj_zakladu_osviti/osvitni_programi',
    icon: 'fa-solid fa-graduation-cap',
    external: false
  },
  {
    title: 'Територія обслуговування',
    href: '/vidkritistj_ta_prozoristj_zakladu_osviti/teritoriya_obslugovuvannya',
    icon: 'fa-solid fa-[#4b6496]-location-dot',
    external: false
  },
  {
    title: 'Ліцензований обсяг та фактична кількість здобувачів освіти',
    href: '/vidkritistj_ta_prozoristj_zakladu_osviti/licenzovanij_obsyag_ta_faktichna_kiljkistj_zdobuvachiv_osviti',
    icon: 'fa-solid fa-user-graduate',
    external: false
  },
  {
    title: 'Мова освітнього процесу',
    href: '/vidkritistj_ta_prozoristj_zakladu_osviti/mova_osvyatnjogo_procesu',
    icon: 'fa-solid fa-language',
    external: false
  },
  {
    title: 'Вакансії',
    href: '/vidkritistj_ta_prozoristj_zakladu_osviti/vakansii',
    icon: 'fa-solid fa-briefcase',
    external: false
  },
  {
    title: 'Матеріально-технічне забезпечення',
    href: '/vidkritistj_ta_prozoristj_zakladu_osviti/materialjno-tehnichne_zabezpechennya',
    icon: 'fa-solid fa-laptop-house',
    external: false
  },
  {
    title: 'Результати моніторингу якості освіти',
    href: '/vidkritistj_ta_prozoristj_zakladu_osviti/rezuljtati_monitoringu_yakosti_osviti',
    icon: 'fa-solid fa-chart-line',
    external: false
  },
  {
    title: 'Моніторингові дослідження',
    href: '/vidkritistj_ta_prozoristj_zakladu_osviti/monitoringovi_doslidzhennya',
    icon: 'fa-solid fa-magnifying-glass-chart',
    external: false
  },
  {
    title: 'Звітування (річний звіт про діяльність закладу та звіт про використання коштів)',
    href: '/vidkritistj_ta_prozoristj_zakladu_osviti/zvituvannya',
    icon: 'fa-solid fa-file-invoice-dollar',
    external: false
  },
  {
    title: 'Правила прийому',
    href: '/vidkritistj_ta_prozoristj_zakladu_osviti/pravila_prijomu',
    icon: 'fa-solid fa-clipboard-list',
    external: false
  },
  {
    title: 'Перелік додаткових освітніх та інших послуг, їх вартість, порядок надання',
    href: '/vidkritistj_ta_prozoristj_zakladu_osviti/perelik_dodatkovih_osvitnih_ta_inshih_poslug_ih_vartistj_poryadok_nadannya',
    icon: 'fa-solid fa-hand-holding-dollar',
    external: false
  },
  {
    title: 'Правила поведінки здобувача освіти',
    href: '/vidkritistj_ta_prozoristj_zakladu_osviti/pravila_povedinki_zdobuvacha_osviti',
    icon: 'fa-solid fa-scale-balanced',
    external: false
  },
  {
    title: 'Заходи із протидії булінгу у закладі',
    href: '/vidkritistj_ta_prozoristj_zakladu_osviti/zahodi_iz_protidiibulingu_u_zakladi',
    icon: 'fa-solid fa-[#4b6496]-shield-heart',
    external: false
  },
  {
    title: 'Вільні місця',
    href: '/vidkritistj_ta_prozoristj_zakladu_osviti/viljni_miscya',
    icon: 'fa-solid fa-chair',
    external: false
  },
  {
    title: 'Кошторис',
    href: '/vidkritistj_ta_prozoristj_zakladu_osviti/koshtoris',
    icon: 'fa-solid fa-calculator',
    external: false
  }
