---

<div class="flex-grow container mx-auto px-4 py-8 sm:px-6 lg:px-8 font-inter">
  <!-- TITLE CONTAINER WITH DECORATIVE UNDERLINE -->
  <div class="text-center mb-10">
    <h1 class="page-title font-oswald text-3xl sm:text-4xl lg:text-5xl font-bold text-slate-800 relative pb-4 inline-block tracking-wide">
      <i class="fa-solid fa-file-lines text-[#4b6496] mr-3"></i>Звіти закладу освіти
    </h1>
    <p class="text-slate-500 text-sm sm:text-base mt-3 max-w-2xl mx-auto">
      Офіційні підсумки діяльності, фінансові звіти використання бюджетних коштів та матеріально-технічний стан Гімназії №201
    </p>
  </div>

  <!-- REPORTS LIST -->
  <div class="max-w-5xl mx-auto space-y-4">
    {reports.map((item) => (
      <div 
        class={`group relative rounded-2xl p-5 border transition-all duration-300 hover:shadow-lg hover:-translate-y-0.5 bg-white ${
          item.type === 'governance' 
            ? 'border-l-4 border-l-[#4b6496] border-slate-200/80 bg-gradient-to-r from-[#f0f4f8]/60 to-white' 
            : item.type === 'property'
            ? 'border-l-4 border-l-amber-500 border-slate-200/80 bg-gradient-to-r from-amber-50/50 to-white'
            : 'border-l-4 border-l-slate-400 border-slate-200/80 hover:border-l-[#394e77]'
        }`}
      >
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          
          <!-- Left side: Icon & Title -->
          <div class="flex items-start gap-4 flex-grow">
            <div class={`w-10 h-10 rounded-xl flex items-center justify-center shrink-0 mt-0.5 transition-colors ${
              item.type === 'governance'
                ? 'bg-[#4b6496]/10 text-[#4b6496] group-hover:bg-[#4b6496] group-hover:text-white'
                : item.type === 'property'
                ? 'bg-amber-100 text-amber-700 group-hover:bg-amber-500 group-hover:text-white'
                : 'bg-slate-100 text-slate-600 group-hover:bg-slate-700 group-hover:text-white'
            }`}>
              <i class={`${item.icon} text-lg`}></i>
            </div>

            <div class="space-y-1">
              <div class="flex items-center gap-2">
                <span class={`text-[11px] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full ${
                  item.type === 'governance'
                    ? 'bg-[#4b6496]/15 text-[#394e77]'
                    : item.type === 'property'
                    ? 'bg-amber-100 text-amber-800'
                    : 'bg-slate-100 text-slate-700'
                }`}>
                  {item.tag}
                </span>
              </div>

              <a 
                href={item.url} 
                target="_blank" 
                rel="noopener noreferrer"
                class="block text-base sm:text-lg font-semibold text-slate-800 hover:text-[#4b6496] transition-colors leading-snug group-hover:text-[#394e77]"
              >
                {item.title}
              </a>
            </div>
          </div>

          <!-- Right side: Action Button -->
          <div class="sm:self-center shrink-0 pt-2 sm:pt-0 border-t sm:border-t-0 border-slate-100 flex items-center justify-end">
            <a 
              href={item.url} 
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-xs font-semibold px-4 py-2 rounded-xl border border-slate-200 text-slate-700 hover:text-white hover:bg-[#4b6496] hover:border-[#4b6496] transition-all shadow-sm group-hover:shadow"
            >
              <span>Переглянути</span>
              <i class="fa-solid fa-arrow-up-right-from-square text-[11px]"></i>
            </a>
          </div>

        </div>
      </div>
    ))}
  </div>
</div>

<style>
  /* Всі шрифти та кольори успадковуються від головного лейауту сайту */
  .page-title::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 80px;
    height: 4px;
    background-color: #4b6496;
    border-radius: 9999px;
  }
</style>
