---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Layout from '../../layouts/Layout.astro';
import CategoriesMenu from '../../components/InformationAboutInstitution/CategoriesMenuInfoAboutInst.astro';
---

<Layout>
    <Header />
    <CategoriesMenu />
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
        <!-- PAGE TITLE SECTION -->
        <div class="text-center mb-12">
            <h1
                class="page-title font-oswald text-3xl sm:text-4xl lg:text-5xl font-bold text-slate-800 relative pb-4 inline-block tracking-wide"
            >
                <i class="fa-solid fa-user-tie text-brand-500 mr-2"></i>Адміністрація гімназії №201
            </h1>
            <p class="text-slate-500 text-sm sm:text-base mt-3 max-w-2xl mx-auto">
                Керівний склад закладу, який забезпечує високий рівень освітнього процесу та комфортне середовище для
                розвитку кожного учня
            </p>
        </div>

        <!-- ADMINISTRATION GRID -->
        <section>
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-6">
                <!-- Director -->
                <article
                    class="bg-white rounded-2xl overflow-hidden shadow-md border border-slate-100 flex flex-col justify-between hover:shadow-xl transition-all duration-300 hover:-translate-y-1 group"
                >
                    <div>
                        <div class="relative overflow-hidden aspect-[4/5] bg-slate-100">
                            <img
                                src="https://github.com/gymnasium201-kyiv/gymnasium201-kyiv.github.io/blob/main/public/informaciya_pro_zaklad/admin%20(1).JPG?raw=true"
                                alt="Гмиря Ганна Володимирівна"
                                class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500"
                            />
                            <span
                                class="absolute top-3 left-3 bg-amber-500/90 backdrop-blur-md text-white text-xs font-semibold px-3 py-1 rounded-full shadow-md"
                            >
                                Директор
                            </span>
                        </div>
                        <div class="p-6 text-center">
                            <h3
                                class="font-oswald text-xl font-bold text-slate-800 leading-snug mb-2 group-hover:text-brand-500 transition-colors"
                            >
                                Гмиря Ганна Володимирівна
                            </h3>
                            <p class="text-xs uppercase font-semibold text-amber-600 tracking-wider mb-3">
                                Директор гімназії
                            </p>
                            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">
                                Учитель зарубіжної літератури, спеціаліст вищої категорії, учитель-методист, «Відмінник освіти України».
                            </p>
                        </div>
                    </div>
                </article>

                <!-- Deputy 1 -->
                <article
                    class="bg-white rounded-2xl overflow-hidden shadow-md border border-slate-100 flex flex-col justify-between hover:shadow-xl transition-all duration-300 hover:-translate-y-1 group"
                >
                    <div>
                        <div class="relative overflow-hidden aspect-[4/5] bg-slate-100">
                            <img
                                src="https://github.com/gymnasium201-kyiv/gymnasium201-kyiv.github.io/blob/main/public/informaciya_pro_zaklad/admin%20(2).JPG?raw=true"
                                alt="Мефодьєва Світлана Олександрівна"
                                class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500"
                            />
                            <span
                                class="absolute top-3 left-3 bg-brand-500/90 backdrop-blur-md text-white text-xs font-semibold px-3 py-1 rounded-full shadow-md"
                            >
                                Заступник директора
                            </span>
                        </div>
                        <div class="p-6 text-center">
                            <h3
                                class="font-oswald text-xl font-bold text-slate-800 leading-snug mb-2 group-hover:text-brand-500 transition-colors"
                            >
                                Мефодьєва Світлана Олександрівна
                            </h3>
                            <p class="text-xs uppercase font-semibold text-brand-600 tracking-wider mb-3">
                                З навчально-виховної роботи
                            </p>
                            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">
                                Учитель української мови і літератури, спеціаліст вищої категорії, вчитель-методист, «Відмінник освіти України».
                            </p>
                        </div>
                    </div>
                </article>

                <!-- Deputy 2 -->
                <article
                    class="bg-white rounded-2xl overflow-hidden shadow-md border border-slate-100 flex flex-col justify-between hover:shadow-xl transition-all duration-300 hover:-translate-y-1 group"
                >
                    <div>
                        <div class="relative overflow-hidden aspect-[4/5] bg-slate-100">
                            <img
                                src="https://github.com/gymnasium201-kyiv/gymnasium201-kyiv.github.io/blob/main/public/informaciya_pro_zaklad/admin%20(3).JPG?raw=true"
                                alt="Лобанова Юлія Юріївна"
                                class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500"
                            />
                            <span
                                class="absolute top-3 left-3 bg-brand-500/90 backdrop-blur-md text-white text-xs font-semibold px-3 py-1 rounded-full shadow-md"
                            >
                                Заступник директора
                            </span>
                        </div>
                        <div class="p-6 text-center">
                            <h3
                                class="font-oswald text-xl font-bold text-slate-800 leading-snug mb-2 group-hover:text-brand-500 transition-colors"
                            >
                                Лобанова Юлія Юріївна
                            </h3>
                            <p class="text-xs uppercase font-semibold text-brand-600 tracking-wider mb-3">
                                З навчально-виховної роботи
                            </p>
                            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">
                                Учитель фізики та астрономії, спеціаліст вищої категорії, вчитель-методист.
                            </p>
                        </div>
                    </div>
                </article>

                <!-- Deputy 3 -->
                <article
                    class="bg-white rounded-2xl overflow-hidden shadow-md border border-slate-100 flex flex-col justify-between hover:shadow-xl transition-all duration-300 hover:-translate-y-1 group"
                >
                    <div>
                        <div class="relative overflow-hidden aspect-[4/5] bg-slate-100">
                            <img
                                src="https://github.com/gymnasium201-kyiv/gymnasium201-kyiv.github.io/blob/main/public/informaciya_pro_zaklad/admin%20(4).jpg?raw=true"
                                alt="Лейко Інна Вікторівна"
                                class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500"
                            />
                            <span
                                class="absolute top-3 left-3 bg-brand-500/90 backdrop-blur-md text-white text-xs font-semibold px-3 py-1 rounded-full shadow-md"
                            >
                                Заступник директора
                            </span>
                        </div>
                        <div class="p-6 text-center">
                            <h3
                                class="font-oswald text-xl font-bold text-slate-800 leading-snug mb-2 group-hover:text-brand-500 transition-colors"
                            >
                                Лейко Інна Вікторівна
                            </h3>
                            <p class="text-xs uppercase font-semibold text-brand-600 tracking-wider mb-3">
                                З навчально-виховної роботи
                            </p>
                            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">
                                Учитель хімії, спеціаліст вищої категорії, вчитель-методист.
                            </p>
                        </div>
                    </div>
                </article>

                <!-- Deputy 4 (АГЧ) -->
                <article
                    class="bg-white rounded-2xl overflow-hidden shadow-md border border-slate-100 flex flex-col justify-between hover:shadow-xl transition-all duration-300 hover:-translate-y-1 group"
                >
                    <div>
                        <div class="relative overflow-hidden aspect-[4/5] bg-slate-100">
                            <img
                                src="https://github.com/gymnasium201-kyiv/gymnasium201-kyiv.github.io/blob/main/public/informaciya_pro_zaklad/admin%20(5).jpg?raw=true"
                                alt="Мельник Наталія Павлівна"
                                class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500"
                            />
                            <span
                                class="absolute top-3 left-3 bg-brand-500/90 backdrop-blur-md text-white text-xs font-semibold px-3 py-1 rounded-full shadow-md"
                            >
                                Заступник директора
                            </span>
                        </div>
                        <div class="p-6 text-center">
                            <h3
                                class="font-oswald text-xl font-bold text-slate-800 leading-snug mb-2 group-hover:text-brand-500 transition-colors"
                            >
                                Мельник Наталія Павлівна
                            </h3>
                            <p class="text-xs uppercase font-semibold text-brand-600 tracking-wider mb-3">
                                З адміністративно-господарської частини
                            </p>
                            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">
                                Забезпечує належне матеріально-технічне функціонування та господарську діяльність гімназії.
                            </p>
                        </div>
                    </div>
                </article>
            </div>
        </section>
    </div>

    <style>
        /* Page title line matching new design spec */
        .page-title::after {
            content: "";
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 80px;
            height: 4px;
            background-color: #4b6496;
            border-radius: 9999px;
        }
    </style>
    <Footer />
</Layout>
