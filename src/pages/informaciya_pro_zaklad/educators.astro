---
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import Footer from '../../components/Footer.astro';
import Layout from '../../layouts/Layout.astro';
import CategoriesMenu from '../../components/InformationAboutInstitution/CategoriesMenuInfoAboutInst.astro'
---

<Layout>
	<Header />
	<Hero />
	<CategoriesMenu />
    <section class="py-6 sm:py-10">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    
    <!-- Заголовок розділу -->
    <div class="text-center mb-10">
      <h1 class="font-oswald text-3xl sm:text-5xl font-bold text-slate-800 relative pb-4 inline-block tracking-wide page-title">
        Педагогічний колектив Гімназії №201
      </h1>
      <p class="text-slate-500 text-sm sm:text-base mt-3 max-w-2xl mx-auto">
        Висококваліфікована команда освітян, які надихають, навчають та формують майбутнє наших учнів
      </p>
    </div>

    <!-- Загальна статистика закладу (Основні показники) -->
    <div class="bg-gradient-to-br from-[#394e77] via-[#4b6496] to-[#2c3e50] rounded-3xl p-6 sm:p-8 text-white shadow-xl mb-12 relative overflow-hidden">
      <!-- Декоративна фонова іконка -->
      <div class="absolute -right-6 -bottom-6 text-white/10 text-9xl pointer-events-none">
        <i class="fa-solid fa-graduation-cap"></i>
      </div>

      <div class="relative z-10 text-center max-w-3xl mx-auto">
        <span class="bg-amber-400/20 text-amber-300 border border-amber-400/30 text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wider inline-block mb-3">
          Загальний склад
        </span>
        <h2 class="font-oswald text-2xl sm:text-4xl font-bold mb-4 leading-tight">
          У гімназії працює <span class="text-amber-400 underline decoration-amber-400/50 underline-offset-4">75 педагогічних працівників</span>
        </h2>
        <div class="flex flex-wrap justify-center gap-4 sm:gap-8 text-slate-200 text-sm sm:text-base font-medium pt-2">
          <div class="flex items-center gap-2 bg-white/10 px-4 py-2 rounded-xl backdrop-blur-sm border border-white/10">
            <i class="fa-solid fa-user-check text-emerald-400"></i>
            <span><strong>69</strong> за основним місцем роботи</span>
          </div>
          <div class="flex items-center gap-2 bg-white/10 px-4 py-2 rounded-xl backdrop-blur-sm border border-white/10">
            <i class="fa-solid fa-briefcase text-amber-300"></i>
            <span><strong>6</strong> за сумісництвом</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Картки характеристик та досягнень -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
      
      <!-- Кваліфікаційні категорії -->
      <div class="bg-white rounded-2xl p-6 shadow-md border border-slate-100 hover:shadow-xl transition-all duration-300 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-xl mb-4">
            <i class="fa-solid fa-award"></i>
          </div>
          <h3 class="font-oswald text-xl font-bold text-slate-800 mb-4 border-b pb-2 border-slate-100">
            Кваліфікаційні категорії
          </h3>
          <ul class="space-y-3 text-slate-600 text-sm">
            <li class="flex items-center justify-between">
              <span>Спеціаліст вищої категорії</span>
              <span class="font-bold text-slate-900 bg-slate-100 px-2.5 py-0.5 rounded-full">21</span>
            </li>
            <li class="flex items-center justify-between">
              <span>Спеціаліст першої категорії</span>
              <span class="font-bold text-slate-900 bg-slate-100 px-2.5 py-0.5 rounded-full">8</span>
            </li>
            <li class="flex items-center justify-between">
              <span>Спеціаліст другої категорії</span>
              <span class="font-bold text-slate-900 bg-slate-100 px-2.5 py-0.5 rounded-full">7</span>
            </li>
            <li class="flex items-center justify-between">
              <span>Спеціаліст</span>
              <span class="font-bold text-slate-900 bg-slate-100 px-2.5 py-0.5 rounded-full">39</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Педагогічні звання -->
      <div class="bg-white rounded-2xl p-6 shadow-md border border-slate-100 hover:shadow-xl transition-all duration-300 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-xl mb-4">
            <i class="fa-solid fa-star"></i>
          </div>
          <h3 class="font-oswald text-xl font-bold text-slate-800 mb-4 border-b pb-2 border-slate-100">
            Педагогічні звання
          </h3>
          <ul class="space-y-3 text-slate-600 text-sm">
            <li class="flex items-center justify-between">
              <span>"Учитель-методист"</span>
              <span class="font-bold font-oswald text-amber-600 bg-amber-50 px-2.5 py-0.5 rounded-full">12</span>
            </li>
            <li class="flex items-center justify-between">
              <span>"Старший учитель"</span>
              <span class="font-bold font-oswald text-amber-600 bg-amber-50 px-2.5 py-0.5 rounded-full">6</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Наукові ступені та відзнаки -->
      <div class="bg-white rounded-2xl p-6 shadow-md border border-slate-100 hover:shadow-xl transition-all duration-300 flex flex-col justify-between md:col-span-2 lg:col-span-1">
        <div>
          <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl mb-4">
            <i class="fa-solid fa-certificate"></i>
          </div>
          <h3 class="font-oswald text-xl font-bold text-slate-800 mb-4 border-b pb-2 border-slate-100">
            Науковий потенціал та нагороди
          </h3>
          <div class="space-y-4">
            <div class="p-3 bg-slate-50 rounded-xl border border-slate-100 flex items-center justify-between">
              <span class="text-xs sm:text-sm font-medium text-slate-700">Кандидат наук</span>
              <span class="text-xs font-bold bg-emerald-100 text-emerald-800 px-2.5 py-1 rounded-lg">1 вчитель</span>
            </div>
            <div class="p-3 bg-slate-50 rounded-xl border border-slate-100 flex items-center justify-between">
              <span class="text-xs sm:text-sm font-medium text-slate-700">Нагрудний знак «Відмінник освіти України»</span>
              <span class="text-xs font-bold bg-emerald-100 text-emerald-800 px-2.5 py-1 rounded-lg">3 вчителі</span>
            </div>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>

<style>
  /* Стиль для лінії під заголовком */
  .page-title::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 80px;
    height: 4px;
    background-color: #4b6496;
    border-radius: 9999px;
  }
</style>
	<Footer />
</Layout>
